# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored by default in Next.js.

# AssemblyAI — speech-to-text with word-level timestamps
# Get a key: https://www.assemblyai.com/dashboard (free tier available)
ASSEMBLYAI_API_KEY=

# Anthropic — Claude API for clip analysis
# Get a key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional explicit paths to binaries (otherwise resolved from PATH)
YTDLP_PATH=
FFMPEG_PATH=

# Supabase — auth, clips history, Sparks balances
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, used by the Stripe webhook to update tiers.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Pro subscriptions ($29/mo)
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (dev)
# or Dashboard → Developers → Webhooks (prod)
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created recurring Price id (price_…). If empty, Klyp creates
# the $29/mo price inline at checkout.
STRIPE_PRICE_PRO=
