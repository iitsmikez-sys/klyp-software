# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored by default in Next.js.
#
# This repo deploys as TWO separate services:
#   - Frontend (Vercel): dashboard, auth, billing — does NOT need
#     ASSEMBLYAI_API_KEY / ANTHROPIC_API_KEY / YTDLP_PATH / FFMPEG_PATH.
#   - Processing (Railway et al.): /api/analyze, /api/preview, /api/clip,
#     /api/upload, /api/duration and editor-media finalization — needs the
#     server-only SUPABASE_SERVICE_ROLE_KEY for editor media and Auto-Clipping,
#     but does NOT need any STRIPE_* var.
# In local dev, one server plays both roles — set DEPLOYMENT_TARGET=processing
# and leave NEXT_PUBLIC_PROCESSING_API_URL empty so everything stays same-origin.

# Which role this deployment plays. Set to "processing" on the video-processing
# service (Railway) AND in local dev (one server = both roles there). Leave
# unset on the Vercel frontend — it's what makes analyze/clip/preview/upload/
# duration correctly 404 there instead of trying to spawn a missing yt-dlp.
DEPLOYMENT_TARGET=processing

# AssemblyAI — speech-to-text with word-level timestamps (processing service only)
# Get a key: https://www.assemblyai.com/dashboard (free tier available)
ASSEMBLYAI_API_KEY=

# Anthropic — Claude API for clip analysis (processing service only)
# Get a key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional explicit paths to binaries (otherwise resolved from PATH) — processing service only
YTDLP_PATH=
FFMPEG_PATH=

# Private beta gate — shared keyword required before /login is reachable.
# Frontend (Vercel) only. Server-side only: never exposed to the client.

# Supabase — auth, clips history, Sparks balances (both services)
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only. Used by the Stripe webhook (Vercel) AND by
# the Auto-Clipping background worker (processing service — lib/vod-poll.ts,
# app/api/twitch/eventsub) since neither has a per-request user session to
# scope a normal query to. Also required by editor-media routes on both services
# for signed private uploads/previews, verified metadata and storage cleanup.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Twitch — Auto-Clipping OAuth connect + EventSub + Get Videos (both services)
# Register an app: https://dev.twitch.tv/console/apps
# OAuth redirect URIs to add there: https://www.klyp.world/api/twitch/callback
# (and http://localhost:3000/api/twitch/callback for local dev)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Any random 10-100 char string — shared secret Twitch signs EventSub webhook
# payloads with. Generate with: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=

# YouTube posting and native scheduling for confirmed Pro subscribers.
# Enable YouTube Data API v3 in a Google Cloud project, configure its OAuth
# consent screen, and create a Web application OAuth client. Add the exact
# YOUTUBE_REDIRECT_URI to Google's authorized redirect URIs.
# YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, and YOUTUBE_TOKEN_ENCRYPTION_KEY
# are server-only and required on the frontend (OAuth callback/token refresh).
# YOUTUBE_REDIRECT_URI and YOUTUBE_WORKER_SIGNING_KEY are required on both
# frontend and processing service. Use the SAME random signing key on both.
# Generate the frontend's 32-byte base64 encryption key
# locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never prefix any of these with NEXT_PUBLIC_.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://www.klyp.world/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_WORKER_SIGNING_KEY=

# Frontend (Vercel) only: base URL of the processing service, e.g.
# https://klyp-processing.up.railway.app — leave empty in local dev (relative
# same-origin fetches instead).
NEXT_PUBLIC_PROCESSING_API_URL=

# Processing service only: origin allowed to call these routes cross-origin,
# e.g. https://klyp.world — falls back to "*" if unset (fine for local dev).
ALLOWED_ORIGIN=

# Processing service: a persistent mounted volume shared with the worker.
# Required for uploaded VOD retries after a container restart or replacement.
KLYP_UPLOAD_DIR=

# Stripe — Pro subscriptions ($28/mo) — frontend (Vercel) only
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (dev)
# or Dashboard → Developers → Webhooks (prod)
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created recurring Price id (price_…). If empty, Klyp creates
# the $28/mo price inline at checkout.
STRIPE_PRICE_PRO=
